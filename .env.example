# ─── TERA-STRIPE Environment Configuration ───
# Copy to .env and fill in production values.

ENVIRONMENT=development
PROJECT_NAME=TERA-STRIPE Wildlife Intelligence Platform

# PostgreSQL 16 + PostGIS 3.4
DATABASE_URL=postgresql://ranger_admin:pench_secure_pass_2026@localhost:5432/pench_wildlife_db
SQLITE_FALLBACK_URL=sqlite:///./pench_wildlife_fallback.db
USE_POSTGIS=false

# Redis 7
REDIS_URL=redis://localhost:6379/0

# MinIO Object Store
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=pench_minio_2026

# GPU / Hardware
VRAM_BUDGET_GB=6.0
DEVICE=cuda:0
MD_BATCH_SIZE=32DINO_BATCH_SIZE=16

# Detection & Re-ID Thresholds
CONF_BLANK_RECALL_GATE=0.15
SIM_REID_AUTO_MATCH=0.85
SIM_REID_REVIEW_MIN=0.60

# Spatial Alert Parameters
DIST_VILLAGE_ALERT_KM=5.0
SHIFT_CORE_CENTROID_KM2=15.0
SHIFT_BUFFER_CENTROID_KM2=5.0
DAYS_ABSENCE_ALERT=45

# Spatial CRS Projections
STORAGE_CRS=EPSG:4326
METRIC_CRS=EPSG:32644
